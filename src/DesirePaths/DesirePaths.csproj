<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Valheim's Unity runtime uses the .NET Standard 2.1 profile. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DesirePaths</AssemblyName>
    <RootNamespace>DesirePaths</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Lets the publicized game assembly be used without runtime access checks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Point this at your Valheim install, either here, with -p:ValheimDir=..., or with
    a VALHEIM_DIR environment variable. BepInEx must already be installed there.
  -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(VALHEIM_DIR)' != ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)/BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Optional: dotnet build -p:DeployToGame=true copies the plugin into BepInEx/plugins. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)/plugins/DesirePaths" />
  </Target>

  <!--
    dotnet build -c Release -p:PackageZip=true writes dist/DesirePaths-<version>.zip with the
    DLL at the archive root, which mod managers (Vortex, r2modman) install into BepInEx/plugins.
  -->
  <Target Name="PackageZip" AfterTargets="Build" Condition="'$(PackageZip)' == 'true'">
    <PropertyGroup>
      <ZipStaging>$(BaseIntermediateOutputPath)zip/</ZipStaging>
      <DistDir>$(MSBuildProjectDirectory)/../../dist/</DistDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ZipStaging)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/../../README.md;$(MSBuildProjectDirectory)/../../thunderstore/manifest.json" DestinationFolder="$(ZipStaging)" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(ZipStaging)" DestinationFile="$(DistDir)DesirePaths-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(DistDir)DesirePaths-$(Version).zip" />
  </Target>

</Project>
